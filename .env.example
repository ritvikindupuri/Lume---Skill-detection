# Supabase Configuration
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-anon-or-publishable-key>
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-anon-or-publishable-key>

# Supabase Service Role Key (Optional / Server Admin only)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>

# OpenAI API Key
# Required for Live AI Review and AI-assisted check generation (GPT reasoning)
OPENAI_API_KEY=sk-<your-openai-api-key>

# PostgreSQL Database URL (Optional - for Drizzle Studio / migrations)
# DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres
